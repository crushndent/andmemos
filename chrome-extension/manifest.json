{
  "manifest_version": 3,
  "name": "Memos Web Clipper",
  "version": "0.1.0",
  "description": "Save the current page, link or selection as a note on your own Memos server.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "contextMenus", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Save to Memos",
    "default_popup": "src/popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "options_ui": { "page": "src/options/options.html", "open_in_tab": true },
  "background": { "service_worker": "src/background/background.js", "type": "module" },
  "commands": {
    "save-page": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Save the current page to Memos"
    }
  }
}
